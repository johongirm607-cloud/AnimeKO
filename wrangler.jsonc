{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animeko",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "animeko"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "animeko",
      "database_id": "4cf78e22-b44f-4f4f-b220-be644fa3c4fd",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
